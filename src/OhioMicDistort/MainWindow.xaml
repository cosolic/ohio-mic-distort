<Window x:Class="OhioMicDistort.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ohio Mic Distort — Mic-Only Equalizer APO Controller"
        Width="560"
        Height="700"
        MinWidth="520"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <!-- HEADER -->
            <Border Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="OHIO MIC DISTORT"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#F87171" />
                        <TextBlock Text="Locks Equalizer APO distortion strictly to your Microphone GUID — Headphones stay 100% untouched."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border x:Name="ApoStatusBadge"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Background="#1E293B"
                            CornerRadius="6"
                            Padding="10,5"
                            Margin="10,0,0,0">
                        <TextBlock x:Name="ApoStatusText"
                                   Text="Checking APO..."
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#93C5FD" />
                    </Border>
                </Grid>
            </Border>

            <!-- PERMISSION BANNER (SHOWN ONLY IF PROGRAM FILES NEEDS WRITE PERMISSION) -->
            <Border x:Name="PermissionBanner"
                    Visibility="Collapsed"
                    Background="#3B1D1D"
                    BorderBrush="#DC2626"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Equalizer APO's config folder requires write permission so rules can update instantly without running as Admin."
                               FontSize="12"
                               Foreground="#FCA5A5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button x:Name="GrantPermissionButton"
                            Grid.Column="1"
                            Content="Grant Write Access"
                            Click="GrantPermissionButton_Click"
                            Background="#DC2626"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Padding="12,6"
                            Margin="10,0,0,0"
                            Cursor="Hand" />
                </Grid>
            </Border>

            <!-- 1. MICROPHONE SELECTION (CAPTURE ENDPOINTS ONLY) -->
            <Border Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="1. TARGET MICROPHONE (CAPTURE ONLY)"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button Grid.Column="1"
                                Content="Refresh Mics"
                                Click="RefreshMicsButton_Click"
                                Background="#262B38"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="#374151"
                                BorderThickness="1"
                                Padding="10,4"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Cursor="Hand" />
                        <Button Grid.Column="2"
                                Content="Open APO Device Selector"
                                Click="OpenApoConfiguratorButton_Click"
                                Background="#262B38"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="#374151"
                                BorderThickness="1"
                                Padding="10,4"
                                FontSize="11"
                                Cursor="Hand" />
                    </Grid>

                    <ComboBox x:Name="MicComboBox"
                              SelectionChanged="MicComboBox_SelectionChanged"
                              Height="34"
                              FontSize="13"
                              VerticalContentAlignment="Center"
                              Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EndpointGuidText"
                                   Grid.Column="0"
                                   Text="Endpoint GUID: —"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="✔ HEADPHONES ISOLATED"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Live Input Level Meter (Read-Only Capture Monitor) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Mic Input Level:"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <ProgressBar x:Name="MicLevelBar"
                                     Grid.Column="1"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Height="10"
                                     Background="#0F1117"
                                     Foreground="#10B981"
                                     BorderBrush="#282D3C" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. BIG TOGGLE BUTTON + GLOBAL HOTKEY -->
            <Border Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="2. DISTORTION SWITCH &amp; IN-GAME HOTKEY"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Global Hotkey:"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <Button x:Name="BindHotkeyButton"
                                    Content="F8 (Click to Change)"
                                    Click="BindHotkeyButton_Click"
                                    Background="#262B38"
                                    Foreground="#FBBF24"
                                    BorderBrush="#4B5563"
                                    BorderThickness="1"
                                    FontWeight="Bold"
                                    Padding="12,4"
                                    FontSize="12"
                                    Cursor="Hand" />
                        </StackPanel>
                    </Grid>

                    <Button x:Name="DistortToggleButton"
                            Click="DistortToggleButton_Click"
                            Height="82"
                            FontSize="18"
                            FontWeight="Bold"
                            Background="#262B38"
                            Foreground="White"
                            BorderBrush="#374151"
                            BorderThickness="2"
                            Cursor="Hand"
                            Content="DISTORTION: OFF  (Click or Press F8 to Activate)" />
                </StackPanel>
            </Border>

            <!-- 3. INTENSITY (GAIN + HARD CLIP) SLIDER -->
            <Border Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="3. DISTORTION INTENSITY (GAIN &amp; CLIP)"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="IntensityValueText"
                                   Grid.Column="1"
                                   Text="65%  (+39.0 dB Preamp)"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#F87171" />
                    </Grid>

                    <Slider x:Name="IntensitySlider"
                            Minimum="0"
                            Maximum="100"
                            Value="65"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"
                            ValueChanged="IntensitySlider_ValueChanged"
                            Margin="0,4,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="0% (Clean)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="50% (Loud / Crunchy)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="100% (+60 dB Nuclear)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>

                    <CheckBox x:Name="ToasterClipCheckBox"
                              IsChecked="True"
                              Checked="ToasterClipCheckBox_Changed"
                              Unchecked="ToasterClipCheckBox_Changed"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="12"
                              Content="Enable 'Toaster / Xbox 360 Mic' Hard-Clip EQ Shaping (Bass Overdrive + Harsh Vocal Crunch)" />
                </StackPanel>
            </Border>

            <!-- 4. LIVE EQUALIZER APO RULE PREVIEW -->
            <Border Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="ACTIVE EQUALIZER APO RULE (ohio-mic-distort.txt)"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="StatusFooterText"
                                   Grid.Column="1"
                                   Text="Ready"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <TextBox x:Name="ApoRulePreviewBox"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="#0B0D12"
                             Foreground="#A7F3D0"
                             BorderBrush="#282D3C"
                             BorderThickness="1"
                             Padding="10"
                             Height="125"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
