<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OhioMicDistort</AssemblyName>
    <RootNamespace>OhioMicDistort</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ohio-mic-distort</Authors>
    <Description>Microphone-only Equalizer APO distortion controller for Windows 10/11</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
